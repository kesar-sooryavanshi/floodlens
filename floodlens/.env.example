# FloodLens works with zero configuration using free OpenStreetMap tiles.
# To use a different free-tier map provider instead, uncomment and fill these in:

# VITE_MAP_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_ATTRIBUTION=© Your Provider

# Set to "true" to require VITE_MAP_TILE_URL and show a setup message instead of
# falling back to OpenStreetMap tiles.
# VITE_MAP_REQUIRES_KEY=false
